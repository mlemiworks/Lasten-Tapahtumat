{
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "PowerShell(git commit *)",
      "PowerShell(git -C * commit *)"
    ],
    "deny": ["Edit(.claude/state/review.json)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/review-gate.mjs"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
